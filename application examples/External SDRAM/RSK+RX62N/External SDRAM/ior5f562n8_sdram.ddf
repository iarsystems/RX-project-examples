;;-------------------------------------------------------------------------
;;
;;      Definitions of Peripheral I/O registers, I/O register bits,
;;      Interrupt/Exception vectors for Renesas RX R5F562N8.
;;
;;      Copyright (C) 2009 IAR Systems AB.
