//========================================================
// IAR EMBEDDED WORKBENCH
// Example macro file for the CSPY debugger:
// Shows how to set breakpoints and perform actions
// at breakpoint hits without stopping execution.
//
//          
//========================================================

__var _value;
__var _value1;
__var _value2;
__var _ret;
__var breakId;

/* Check if "set breakpoint" was succesful */
checkBreakpoint()
{
  if (breakId == 0)
  {
    __message "Breakpoint set failed\n";
  }
  else
  {
    __message "Breakpoint set OK\n";
  }
}

/* do something at breakpoint hit */
breakpointHit()
{
  // Set the variable ResourceWrite to 1 to enable
  // loading of resources to serial flash
  ResourceWrite=1;

  __message "ResourceWrite is set to 1 to enable writong Resources.bin to serial flash";  
}

//=======================================================
// boardInit
// Macro to do some low leve initialization of the RSKRX62N
// board so SDRAM will be available.
//=======================================================
boardInit()
{

  __message "boardInit called\n";
    
  // Setup the clocks
  // Enable the external memory bus and the on-chip ROM (System control register 0)
  __writeMemory16(0x5A03, 0x00080006, "Memory");

  __message "Configuring clocks\n";
  //---------------------------------Clocks--------------------------------------
  //Configure the clocks
  // SCKCR
  //  Peripheral module clk = 48Mhz
  //  External bus clock    = 48Mhz
  //  System clk            = 96Mhz
  //  ENABLE SDCLK and BCLK
  __writeMemory32(0x00010100, 0x00080020, "Memory");

  //-----------------------------------------------------------------------------
  
  __message "Setting port/pin configurations\n";
  //PF4BUS - enable A15-0
  __writeMemory8(0xFF, 0x0008C104, "Memory");

  //PF5BUS
  __writeMemory8(0x10, 0x0008C105, "Memory");

  //PF6BUS
  __writeMemory8(0xD0, 0x0008C106, "Memory");
  
  for(_value1 = 0; _value1 < 10000; _value1++){}; 
  
  __message "Configuring the SDRAM\n";
  //SDIR (Word)
  __writeMemory16(0x00F0, 0x00083C24, "Memory");
  
  //SDICR
  __writeMemory8(0x01, 0x00083C20, "Memory");
  
  //Wait for SDSR -> INIST bit == 1 (b3 0x08) 
  while ( __readMemory8(0x00083C50, "Memory") & 0x08 == 0x08 ) { }
  //_value = __readMemory8(0x00083C50, "Memory");
  
  //SDCMOD 0x00083C01
  __writeMemory8(0x00, 0x00083C01, "Memory");
  //SDCCR  0x00083C00
  __writeMemory8(0x00, 0x00083C00, "Memory");
  //SDMOD  0x00083C48 (16)
  __writeMemory16(0x0220, 0x00083C48, "Memory");
  //SDRFCR 0x00083C14 (16)
  __writeMemory16(0x42CF, 0x00083C14, "Memory");
  //SDTR   0x00083C44 (32)
  __writeMemory32(0x00000002, 0x00083C44, "Memory");
  //SDADR  0x00083C40
  __writeMemory8(0x01, 0x00083C40, "Memory");
  //SDRFEN 0x00083C16
  __writeMemory8(0x01, 0x00083C16, "Memory");  
  //SDCCR  0x00083C00
  __writeMemory8(0x01, 0x00083C00, "Memory");
  
  for(_value1 = 0; _value1 < 10000; _value1++){};   
  __message "Configuration complete\n";
}

// Called after communication with the target system is established
execUserPreload()
{
  __message "Communication Established\n";

  boardInit();
  
  return 0;
}

// Called once after the target program is downloaded.
execUserSetup()
{
  __message "Program downloaded\n";
  
  // Set a breakpoint at label "main" and call a function at breakpoint hit
  breakId = __setCodeBreak("main", 0, "breakpointHit()", "TRUE", "");  
  checkBreakpoint();  
  
  return 0;
}

// Called each time the reset command is issued
execUserReset()
{
  
  __message "Board Reset\n";
  
  // call boardInit again after reset.
  //boardInit();
  
  return 0;
}

// Called once when the debug session ends
execUserExit()
{
  __message "Debugging stopped\n";
  return 0;
}